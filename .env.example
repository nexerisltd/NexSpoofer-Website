# --- Supabase ---------------------------------------------------------
# Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ----------------------------------------------------------------
# Your deployed base URL (used to build shareable /p/xxxx links server-side)
APP_BASE_URL=http://localhost:3000

# --- Security -------------------------------------------------------------
# Any long random string — used to derive the AES-256 key that encrypts
# origin URLs inside rewritten HLS manifest paths. Generate one with:
#   openssl rand -hex 32
ENCRYPTION_KEY=

# Comma-separated list of hostnames allowed as media origins.
# Subdomains of a listed host are allowed automatically (e.g. listing
# "b-cdn.net" also allows "vz-xxxx.b-cdn.net").
# Additional hosts can also be added later at runtime via the /sa
# "Approved Media Domains" panel — this env var is just the starting set.
ALLOWED_MEDIA_HOSTS=

# --- Bootstrap ------------------------------------------------------------
# The Google account email that should automatically become super_admin
# the first time it signs in. This is the ONLY hardcoded-identity path in
# the app (see lib/auth.ts) — set it once, then manage all other
# roles/admins from the /sa dashboard instead of this env var.
BOOTSTRAP_SUPER_ADMIN_EMAIL=
