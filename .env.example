# --- Supabase ---------------------------------------------------------
# Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ----------------------------------------------------------------
# Your deployed base URL (used to build shareable /p/xxxx links server-side)
APP_BASE_URL=http://localhost:3000

# The deployed Cloudflare Worker's URL — where the actual video/image
# bytes get proxied from (referer spoofing, HLS manifest rewriting, Range
# requests). Get this after running `npx wrangler deploy` inside worker/ —
# it looks like https://nexspoofer-media.<your-subdomain>.workers.dev
# (or your own custom domain if you route one to the Worker).
#
# NOTE: since the multi-server update, this is only used as a FALLBACK for
# links created before that update (server_id = null). New links pick
# their Worker from the media_servers table instead — see /sa -> Media
# Servers. You can leave this set to your original/first Worker.
NEXT_PUBLIC_MEDIA_PROXY_URL=

# --- Security -------------------------------------------------------------
# Comma-separated list of hostnames allowed as media origins — OPTIONAL.
# Primary control is now the Super Admin dashboard: sign in, open /sa,
# and add approved domains there under "Approved Media Domains" — no env
# var or redeploy needed for that. This variable is just an optional
# extra baseline (e.g. useful before you've logged in as Super Admin at
# all). Leave it empty if you want domains managed ENTIRELY from /sa.
#
# IMPORTANT: if this is empty AND no domains have been added in /sa yet,
# link creation is blocked for EVERY host — nothing is approved by
# default, so add at least one domain in /sa before testing LinkGen.
#
# Note: the Worker (worker/wrangler.toml) has its own copy of this same
# variable — both read from the same Supabase allowed_media_domains
# table as the real source of truth, so they naturally stay in sync via
# /sa even though they're two separate deployments.
ALLOWED_MEDIA_HOSTS=

# --- Bootstrap ------------------------------------------------------------
# The Google account email that should automatically become super_admin
# the first time it signs in. This is the ONLY hardcoded-identity path in
# the app (see lib/auth.ts) — set it once, then manage all other
# roles/admins from the /sa dashboard instead of this env var.
BOOTSTRAP_SUPER_ADMIN_EMAIL=

# NOTE: ENCRYPTION_KEY used to live here — it's no longer needed by the
# Next.js app at all. It's now a Cloudflare Worker secret only (see
# worker/README.md), since manifest URL encryption happens entirely
# inside the Worker now.
